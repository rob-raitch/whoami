---
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Rob Aitchison's Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <nav class="bg-white border-b border-slate-200">
      <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-bold text-blue-600">raitch</a>
        <ul class="flex gap-6">
          <li><a href="/" class="hover:text-blue-600 transition">Home</a></li>
          <li><a href="/portfolio" class="hover:text-blue-600 transition">Portfolio</a></li>
          <li><a href="/about" class="hover:text-blue-600 transition">About</a></li>
          <li><a href="/contact" class="hover:text-blue-600 transition">Contact</a></li>
        </ul>
      </div>
    </nav>

    <main class="max-w-5xl mx-auto px-4 py-12">
      <slot />
    </main>

    <footer class="bg-slate-900 text-white mt-16">
      <div class="max-w-5xl mx-auto px-4 py-8 text-center">
        <p>&copy; 2026 Rob Aitchison. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
