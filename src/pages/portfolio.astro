---
import Layout from '../layouts/Layout.astro';

const portfolioItems = [
  {
    title: 'Sovereign Infrastructure Project',
    category: 'software',
    description: 'Open-source FOSS infrastructure initiative inspired by chattanooga.digital',
    image: '/portfolio/sovereign.jpg'
  },
  {
    title: 'Digital Art Series',
    category: 'art',
    description: 'Exploring digital mediums and creative expression',
    image: '/portfolio/art-01.jpg'
  },
  {
    title: 'Web Design Portfolio',
    category: 'design',
    description: 'Modern, responsive web design projects',
    image: '/portfolio/design-01.jpg'
  },
  {
    title: 'Photography Collection',
    category: 'photography',
    description: 'Urban and nature photography studies',
    image: '/portfolio/photo-01.jpg'
  },
];

const categories = ['all', 'software', 'design', 'art', 'photography'];
---

<Layout title="Portfolio | Rob Aitchison">
  <h1 class="text-4xl font-bold mb-12">Portfolio</h1>

  <div class="mb-8 flex flex-wrap gap-3">
    {categories.map(cat => (
      <button
        class="px-4 py-2 rounded-lg border-2 transition"
        class:list={[cat === 'all' ? 'bg-blue-600 text-white border-blue-600' : 'border-slate-300 hover:border-blue-600']}
        data-filter={cat}
      >
        {cat.charAt(0).toUpperCase() + cat.slice(1)}
      </button>
    ))}
  </div>

  <div class="grid md:grid-cols-2 gap-8">
    {portfolioItems.map(item => (
      <div
        class="bg-white rounded-lg border border-slate-200 overflow-hidden hover:shadow-lg transition"
        data-category={item.category}
      >
        <div class="bg-gradient-to-br from-slate-200 to-slate-300 h-48 flex items-center justify-center">
          <span class="text-slate-500">[{item.category.toUpperCase()} IMAGE]</span>
        </div>
        <div class="p-6">
          <span class="text-xs font-bold text-blue-600 uppercase">{item.category}</span>
          <h3 class="text-xl font-bold mt-2 mb-2">{item.title}</h3>
          <p class="text-slate-600">{item.description}</p>
        </div>
      </div>
    ))}
  </div>
</Layout>
