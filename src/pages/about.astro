---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About | Rob Aitchison">
  <h1 class="text-4xl font-bold mb-8">About Me</h1>

  <div class="grid md:grid-cols-3 gap-8">
    <div class="md:col-span-2">
      <section class="mb-8">
        <h2 class="text-2xl font-bold mb-4">Background</h2>
        <p class="text-slate-700 mb-4 leading-relaxed">
          I'm Rob Aitchison, also known as raitch. I'm a multidisciplinary creator with a passion for exploring the intersection of technology, art, and design.
        </p>
        <p class="text-slate-700 mb-4 leading-relaxed">
          My work spans software development, visual design, and artistic expression. I'm particularly interested in FOSS sovereign infrastructure and the creative possibilities at the nexus of these disciplines.
        </p>
      </section>

      <section class="mb-8">
        <h2 class="text-2xl font-bold mb-4">Skills & Interests</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <h3 class="font-bold mb-2">Development</h3>
            <ul class="text-slate-600 space-y-1">
              <li>• Web Development</li>
              <li>• Open Source Software</li>
              <li>• Infrastructure</li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold mb-2">Creative</h3>
            <ul class="text-slate-600 space-y-1">
              <li>• Digital Art</li>
              <li>• Design</li>
              <li>• Photography</li>
            </ul>
          </div>
        </div>
      </section>
    </div>

    <aside class="bg-white p-6 rounded-lg border border-slate-200 h-fit">
      <h3 class="font-bold mb-4">Quick Links</h3>
      <ul class="space-y-3">
        <li>
          <a href="https://www.linkedin.com/in/raitch" target="_blank" class="text-blue-600 hover:underline">
            LinkedIn
          </a>
        </li>
        <li>
          <a href="https://github.com" target="_blank" class="text-blue-600 hover:underline">
            GitHub
          </a>
        </li>
        <li>
          <a href="/contact" class="text-blue-600 hover:underline">
            Contact Me
          </a>
        </li>
      </ul>
    </aside>
  </div>
</Layout>
