---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Rob Aitchison">
  <h1 class="text-4xl font-bold mb-8">Get in Touch</h1>

  <div class="grid md:grid-cols-2 gap-12">
    <div>
      <h2 class="text-2xl font-bold mb-6">Let's Connect</h2>
      <p class="text-slate-600 mb-8">
        Whether you're interested in collaboration, have questions about my work, or just want to say hello, feel free to reach out.
      </p>

      <div class="space-y-6">
        <div>
          <h3 class="font-bold mb-2">Email</h3>
          <p class="text-slate-600">
            <a href="mailto:contact@example.com" class="text-blue-600 hover:underline">
              contact@example.com
            </a>
          </p>
        </div>
        <div>
          <h3 class="font-bold mb-2">Social</h3>
          <ul class="space-y-2">
            <li>
              <a href="https://www.linkedin.com/in/raitch" target="_blank" class="text-blue-600 hover:underline">
                LinkedIn → raitch
              </a>
            </li>
            <li>
              <a href="https://github.com" target="_blank" class="text-blue-600 hover:underline">
                GitHub
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <form class="bg-white p-8 rounded-lg border border-slate-200">
      <div class="mb-6">
        <label for="name" class="block font-bold mb-2">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:border-blue-600"
          required
        />
      </div>

      <div class="mb-6">
        <label for="email" class="block font-bold mb-2">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:border-blue-600"
          required
        />
      </div>

      <div class="mb-6">
        <label for="message" class="block font-bold mb-2">Message</label>
        <textarea
          id="message"
          name="message"
          rows={6}
          class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:border-blue-600"
          required
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-bold"
      >
        Send Message
      </button>
    </form>
  </div>
</Layout>
